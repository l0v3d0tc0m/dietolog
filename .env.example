# Telegram: create a bot with @BotFather, get your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Shared secret the Android app sends with every sync (any long random string)
INGEST_TOKEN=

TZ_NAME=Europe/Moscow
HOST=0.0.0.0
PORT=8765
DB_PATH=data/health.db
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high — how hard Claude thinks
CLAUDE_EFFORT=medium
# Hour to send yesterday's summary, -1 to turn off
MORNING_REPORT_HOUR=9

# Which brain to use: claude_code (your Claude subscription, no API key) or api (ANTHROPIC_API_KEY).
# Empty = api if ANTHROPIC_API_KEY is set, otherwise claude_code.
AGENT_BACKEND=
# Long-lived subscription token from `claude setup-token` (claude_code backend)
CLAUDE_CODE_OAUTH_TOKEN=
# Path to claude.exe; empty = find it automatically
CLAUDE_BIN=
